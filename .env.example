# Copy this file to .env.local and fill it in.
# Without a key the "Ask about my work" demo still works, but answers from simple built-in rules.
ANTHROPIC_API_KEY=
# Optional: choose the model. Check https://docs.claude.com for current model names.
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional: raises the GitHub API limit for the activity grid (a token with no scopes is enough).
GITHUB_TOKEN=
